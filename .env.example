# Public browser values. Use the local values printed by `npm run supabase -- status`
# or the separate Dev/Live Supabase project values. Never commit real secrets.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_APP_ENV=local
VITE_BUILD_VERSION=dev
VITE_DB_MIGRATION_VERSION=20260809000003
# Package 00C: use LIVE_TESTING for the first live release; set VERIFIED only after user PASS.
VITE_RELEASE_PACKAGE=00C
VITE_RELEASE_STATE=BLOCKED
