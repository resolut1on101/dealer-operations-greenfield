{
  "name": "dealer-operations-greenfield",
  "private": true,
  "version": "0.0.0",
  "description": "Greenfield dealer operations platform — Package 00 technical foundation",
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:rls": "node scripts/test-rls.mjs",
    "backup:logical": "node scripts/backup-logical.mjs",
    "restore:rehearsal": "node scripts/restore-rehearsal.mjs",
    "deploy:live": "node scripts/deploy-live.mjs",
    "review:zip": "node scripts/create-review-zip.mjs",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "supabase": "supabase"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "supabase": "^2.39.2",
    "wrangler": "^4.120.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
